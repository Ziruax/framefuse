{
  "name": "framefuse",
  "version": "5.2.1",
  "private": true,
  "description": "FrameFuse v5.2 — Multi-track video studio: video clips, green-screen chroma key with on-canvas PiP, overlay lane, background music with volume/loop, synthesized SFX, native Whisper captions, non-blocking GPU-accelerated parallel FFmpeg export, native project files.",
  "main": "electron/main.js",
  "author": "FrameFuse",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000 2>&1 | tee dev.log",
    "clean": "node scripts/clean.js",
    "build": "npm run clean && next build --webpack && node scripts/copy-wasm.js",
    "start": "next start",
    "lint": "eslint .",
    "electron": "electron electron/main.js",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron electron/main.js\"",
    "fetch:ffmpeg": "node scripts/fetch-windows-ffmpeg.js",
    "stage:whisper": "node scripts/stage-whisper-service.js",
    "postinstall": "node scripts/patch-transformers.js",
    "electron:build": "npm run clean && next build --webpack && node scripts/copy-wasm.js && node scripts/fetch-windows-ffmpeg.js && node scripts/stage-whisper-service.js && electron-builder --win nsis --publish never"
  },
  "trustedDependencies": [
    "electron",
    "ffmpeg-static",
    "electron-builder",
    "unrs-resolver"
  ],
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.525.0",
    "mp4-muxer": "^5.2.2",
    "next": "^16.1.1",
    "onnxruntime-node": "1.14.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.framefuse.app",
    "productName": "FrameFuse",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": "whisper-service",
        "to": "whisper-service"
      },
      {
        "from": "node_modules/@xenova/transformers/dist",
        "to": "transformers-wasm",
        "filter": [
          "**/*.{wasm,mjs}"
        ]
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg-static",
        "filter": [
          "ffmpeg.exe",
          "ffmpeg.LICENSE",
          "ffmpeg.README"
        ]
      }
    ],
    "asarUnpack": [],
    "win": {
      "target": "nsis",
      "signtoolOptions": null,
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FrameFuse",
      "perMachine": false,
      "uninstallDisplayName": "FrameFuse v5",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  }
}
