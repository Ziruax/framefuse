{
  "name": "framefuse",
  "version": "4.5.0",
  "private": true,
  "description": "FrameFuse v4.5 — Native desktop image-to-video merger with viral kinetic captions, segment transitions, watermark/logo overlay, undo/redo, exact word-by-word timing, GPU-accelerated export, and preview-accurate Ken Burns motion.",
  "main": "electron/main.js",
  "author": "FrameFuse",
  "license": "MIT",
  "scripts": {
    "dev": "next dev -p 3000",
    "clean": "node scripts/clean.js",
    "build": "npm run clean && next build --webpack && node scripts/copy-wasm.js",
    "start": "next start",
    "lint": "eslint .",
    "electron": "electron electron/main.js",
    "electron:dev": "concurrently -k \"npm run dev\" \"wait-on http://localhost:3000 && electron electron/main.js\"",
    "fetch:ffmpeg": "node scripts/fetch-windows-ffmpeg.js",
    "electron:build": "npm run clean && next build --webpack && node scripts/copy-wasm.js && node scripts/fetch-windows-ffmpeg.js && electron-builder --win dir --publish never"
  },
  "dependencies": {
    "@xenova/transformers": "^2.17.2",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.2.0",
    "lucide-react": "^0.525.0",
    "mp4-muxer": "^5.2.2",
    "next": "^16.1.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^9.1.2",
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8",
    "eslint": "^9",
    "eslint-config-next": "^16.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "com.framefuse.app",
    "productName": "FrameFuse",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "electron/**/*",
      "build/**/*",
      "package.json",
      "!node_modules"
    ],
    "extraResources": [
      {
        "from": "node_modules/@xenova/transformers/dist",
        "to": "transformers-wasm",
        "filter": [
          "**/*.{wasm,mjs}"
        ]
      },
      {
        "from": "node_modules/ffmpeg-static",
        "to": "ffmpeg-static",
        "filter": [
          "ffmpeg.exe",
          "ffmpeg.LICENSE",
          "ffmpeg.README"
        ]
      }
    ],
    "asarUnpack": [],
    "win": {
      "target": "nsis",
      "signtoolOptions": null,
      "signAndEditExecutable": false,
      "forceCodeSigning": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "FrameFuse",
      "perMachine": false,
      "uninstallDisplayName": "FrameFuse v4",
      "deleteAppDataOnUninstall": false
    },
    "npmRebuild": false
  }
}
